---
import { business } from '../data/site';

const businessDetails = {
  name: business.name,
  phone: business.phone,
  email: business.email,
  showroomAddress: business.address,
  serviceArea: 'Greater Toronto and Hamilton Area (GTHA)',
  website: business.siteUrl,
  quoteUrl: business.quoteUrl,
  bookingUrl: business.bookingUrl,
  showroomDirectionsUrl: business.mapsUrl,
};
---
<script is:inline define:vars={{ businessDetails }}>
  (() => {
    const modelContext = document.modelContext ?? navigator.modelContext;
    if (!modelContext?.registerTool) return;

    const controller = new AbortController();
    const options = { signal: controller.signal };
    const textResult = (text, data) => ({
      content: [{ type: 'text', text }],
      structuredContent: data,
    });

    const tools = [
      {
        name: 'get_business_information',
        description: 'Get verified contact details, showroom address, service area, and website links for H & H Custom Cabinetry.',
        inputSchema: { type: 'object', properties: {}, additionalProperties: false },
        execute: async () => textResult(
          `${businessDetails.name} serves the ${businessDetails.serviceArea}. Call ${businessDetails.phone}, email ${businessDetails.email}, or visit the showroom at ${businessDetails.showroomAddress}.`,
          businessDetails,
        ),
      },
      {
        name: 'get_quote_request_link',
        description: 'Get the official Google Form link for requesting a free custom-cabinetry quote.',
        inputSchema: { type: 'object', properties: {}, additionalProperties: false },
        execute: async () => textResult(
          'Use the official quote request form. It opens on Google Forms and does not confirm an appointment.',
          { quoteUrl: businessDetails.quoteUrl },
        ),
      },
      {
        name: 'get_appointment_request_link',
        description: 'Get the official calendar link for requesting a cabinetry consultation appointment.',
        inputSchema: { type: 'object', properties: {}, additionalProperties: false },
        execute: async () => textResult(
          'This calendar submits an appointment request only. H & H Custom Cabinetry will follow up by email or phone to discuss the project and confirm the exact date and time.',
          { bookingUrl: businessDetails.bookingUrl, confirmationRequired: true },
        ),
      },
    ];

    Promise.allSettled(tools.map((tool) => modelContext.registerTool(tool, options)));
    window.addEventListener('pagehide', () => controller.abort(), { once: true });
  })();
</script>
