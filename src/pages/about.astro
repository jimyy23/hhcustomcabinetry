---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import { business } from '../data/site';
import showroomImage from '../assets/gallery/traditional-kitchen.jpeg';
---
<BaseLayout title="About Us" description="Learn about H & H Custom Cabinetry, serving the Greater Toronto and Hamilton Area with more than 20 years of experience in kitchens, vanities, and built-ins.">
  <header class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>About</span></nav><p class="eyebrow">About H & H Custom Cabinetry</p><h1>Experience. Craftsmanship. Personalized design.</h1><p class="lede">We help homeowners across the GTHA create cabinetry that feels completely at home in their space.</p></div></header>
  <section class="section" aria-labelledby="story-title"><div class="container split"><div class="split__media"><Image src={showroomImage} alt="Traditional white custom kitchen with a dark island" /></div><div class="split__content"><p class="eyebrow">Our approach</p><h2 id="story-title">Great cabinetry begins with listening.</h2><p class="lede">For more than 20 years, H & H Custom Cabinetry has helped transform kitchens, bathrooms, living spaces, and storage areas.</p><p>We take the time to understand your needs, preferences, space, and budget. Then we help you work through layout, materials, finishes, doors, hardware, and practical storage.</p><p>Whether your style is traditional, transitional, contemporary, modern, or somewhere in between, our goal is to create cabinetry that looks and feels right for your home.</p></div></div></section>
  <section class="section section--ivory" aria-labelledby="difference-title"><div class="container"><div class="section-header"><div><p class="eyebrow">Why H & H</p><h2 id="difference-title">Guidance at every step.</h2></div><p>You receive more than cabinets—you receive experience, personalized attention, and a design created specifically for your home.</p></div><div class="about-stats"><div class="stat"><strong>20+</strong><span>Years of cabinetry experience</span></div><div class="stat"><strong>1:1</strong><span>Personalized design guidance</span></div><div class="stat"><strong>Custom</strong><span>Solutions made for your space</span></div></div><div class="values-grid"><article class="value"><h3>Thoughtful design</h3><p>We balance appearance, storage, functionality, and budget in every cabinetry plan.</p></article><article class="value"><h3>Material choice</h3><p>Compare doors, colours, finishes, hardware, and interior options with clear guidance.</p></article><article class="value"><h3>Careful installation</h3><p>We work to ensure your finished cabinetry becomes a beautiful, functional part of your home.</p></article></div></div></section>
  <section class="section" aria-labelledby="showroom-title"><div class="container"><div class="testimonial"><p class="eyebrow">Visit our Mississauga showroom</p><h2 id="showroom-title">See the possibilities in person.</h2><p class="lede" style="margin: 1.5rem auto 2rem">Choosing cabinetry is easier when you can see and feel the materials. Visit our showroom to compare door styles, colours, wood tones, finishes, hardware, and storage options.</p><a class="button" href={business.mapsUrl} target="_blank" rel="noopener noreferrer">Get showroom directions <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></div></div></section>
  <CTA />
</BaseLayout>
