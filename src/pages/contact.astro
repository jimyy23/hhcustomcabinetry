---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { business } from '../data/site';
---
<BaseLayout title="Contact & Appointments" description="Contact H & H Custom Cabinetry for cabinetry projects across the Greater Toronto and Hamilton Area. Request a free quote or book an appointment online.">
  <header class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Contact</span></nav><p class="eyebrow">Serving the GTHA</p><h1>Let’s create something beautiful for your home.</h1><p class="lede">Request a quote, reserve an appointment, or call us to talk about your cabinetry project.</p></div></header>
  <section class="section" aria-labelledby="contact-title"><div class="container contact-grid"><div><p class="eyebrow">Choose what works for you</p><h2 id="contact-title" style="margin-bottom: 2rem">How can we help?</h2><div class="contact-options"><article class="contact-option"><h2>Request a free quote</h2><p>Tell us about your space, ideas, and the cabinetry you are considering.</p><a class="button" href={business.quoteUrl} target="_blank" rel="noopener noreferrer">Open quote form <Icon name="arrow" /><span class="sr-only"> (opens in a new tab)</span></a></article><article class="contact-option"><h2>Request an appointment</h2><p>Select a preferred time through Google Calendar. Our team will follow up to discuss your needs and confirm the appointment.</p><a class="button button--outline" href={business.bookingUrl} data-booking-link aria-haspopup="dialog">View available times <Icon name="calendar" /></a></article><article class="contact-option"><h2>Call us</h2><p>Prefer to speak with someone directly? We would be glad to hear about your project.</p><a class="text-link" href={business.phoneHref}><Icon name="phone" /> {business.phone}</a></article></div></div><aside class="contact-details" aria-labelledby="visit-title"><p class="eyebrow">Visit or connect</p><h2 id="visit-title">H & H Custom Cabinetry</h2><dl><dt>Showroom address</dt><dd><a href={business.mapsUrl} target="_blank" rel="noopener noreferrer">3218 Wharton Way<br />Mississauga, ON L4X 2C1 <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></dd><dt>Phone</dt><dd><a href={business.phoneHref}>{business.phone}</a></dd><dt>Email</dt><dd><a href={`mailto:${business.email}`}>{business.email}</a></dd></dl><p class="contact-note">Bring your ideas. We’ll help turn them into a cabinetry design that combines style, storage, and functionality.</p></aside></div></section>
  <section class="section section--ivory" aria-labelledby="faq-title"><div class="container"><div class="testimonial"><p class="eyebrow">Helpful answers</p><h2 id="faq-title">Frequently asked questions.</h2></div><div class="faq-list"><details><summary>Do you offer custom-sized cabinets?</summary><p>Yes. Our cabinetry can be designed around the dimensions, layout, and storage requirements of your space.</p></details><details><summary>Can you help me choose colours and door styles?</summary><p>Absolutely. We can guide you through door profiles, colours, finishes, materials, and combinations to help you achieve the look you want.</p></details><details><summary>Do you design bathroom vanities?</summary><p>Yes. We offer single and double vanities, floating vanities, furniture-style vanities, linen storage, and other custom bathroom cabinetry.</p></details><details><summary>Do you make built-in cabinetry?</summary><p>Yes. We design built-ins for entertainment areas, offices, living rooms, fireplaces, laundry rooms, mudrooms, bars, bedrooms, and storage spaces.</p></details><details><summary>How do I get started?</summary><p>Call {business.phone}, open the free quote form, or book an appointment online to connect with our team.</p></details></div></div></section>
</BaseLayout>
