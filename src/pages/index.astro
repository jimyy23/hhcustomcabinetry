---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import { business } from '../data/site';
import heroImage from '../assets/gallery/charcoal-kitchen-island.jpeg';
import aboutImage from '../assets/gallery/custom-wine-storage.jpeg';
import kitchenImage from '../assets/gallery/white-kitchen-seating.jpeg';
import vanityImage from '../assets/gallery/fluted-wood-vanity.jpeg';
import builtInImage from '../assets/gallery/display-cabinetry.jpeg';
import mudroomImage from '../assets/gallery/custom-mudroom.jpeg';
---
<BaseLayout title="H & H Cabinet" description="Custom kitchen cabinets, bathroom vanities, and built-ins designed and installed in Mississauga. More than 20 years of cabinetry experience.">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__media">
      <Image src={heroImage} alt="Charcoal custom kitchen with a large marble island and brass fixtures" width={2000} loading="eager" fetchpriority="high" />
    </div>
    <div class="container hero__inner">
      <div class="hero__content">
        <p class="eyebrow">Custom cabinetry · Mississauga</p>
        <h1 id="hero-title">Designed for your home. Built for the way you live.</h1>
        <p>Custom kitchens, beautiful vanities, and built-ins made for you—with thoughtful design and craftsmanship in every detail.</p>
        <div class="hero__actions">
          <a class="button button--light" href={business.quoteUrl} target="_blank" rel="noopener noreferrer">Get a free quote <Icon name="arrow" /><span class="sr-only"> (opens in a new tab)</span></a>
          <a class="button button--outline" style="color: white; border-color: white" href="/gallery/">View our work</a>
        </div>
      </div>
      <div class="hero__proof" aria-label="Company highlights">
        <span>20+ years<br />experience</span>
        <span>Made for<br />your space</span>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="services-title">
    <div class="container">
      <div class="section-header">
        <div><p class="eyebrow">What we create</p><h2 id="services-title">Cabinetry with beauty, function, and lasting value.</h2></div>
        <p>Every project is designed around your space, your style, and your everyday needs—from the first conversation through installation.</p>
      </div>
      <div class="service-grid">
        <a class="service-card" href="/services/#kitchens">
          <span class="service-card__number">01</span><h3>Custom Kitchens</h3>
          <p>Beautiful, functional kitchens planned around your lifestyle, storage needs, and individual taste.</p>
          <span class="text-link">Explore kitchens <Icon name="arrow" /></span>
        </a>
        <a class="service-card" href="/services/#vanities">
          <span class="service-card__number">02</span><h3>Bathroom Vanities</h3>
          <p>Custom vanity solutions in a range of styles, finishes, colours, and practical configurations.</p>
          <span class="text-link">Explore vanities <Icon name="arrow" /></span>
        </a>
        <a class="service-card" href="/services/#built-ins">
          <span class="service-card__number">03</span><h3>Custom Built-Ins</h3>
          <p>Made-to-measure storage that suits your home’s dimensions and looks like it has always belonged.</p>
          <span class="text-link">Explore built-ins <Icon name="arrow" /></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--ivory" aria-labelledby="about-title">
    <div class="container split">
      <div class="split__media"><Image src={aboutImage} alt="Custom wine room with wood cabinetry and bottle storage" /></div>
      <div class="split__content">
        <p class="eyebrow">Experience meets personal design</p>
        <h2 id="about-title">We begin by listening.</h2>
        <p class="lede">For more than 20 years, H & H Cabinet has helped homeowners transform kitchens, bathrooms, living spaces, and storage areas.</p>
        <p>Our experienced team takes the time to understand your needs, preferences, space, and budget before helping you select the right layout, materials, finishes, doors, hardware, and storage solutions.</p>
        <ul class="check-list">
          <li>Custom-designed for your home</li>
          <li>Personalized material and finish guidance</li>
          <li>Careful, professional installation</li>
        </ul>
        <a class="text-link" href="/about/">Meet H & H Cabinet <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="work-title">
    <div class="container">
      <div class="section-header">
        <div><p class="eyebrow">Selected work</p><h2 id="work-title">Spaces made personal.</h2></div>
        <p>Explore a selection of kitchens, vanities, and custom storage created for real homes.</p>
      </div>
      <div class="project-grid">
        <a class="project-card" href="/gallery/"><Image src={kitchenImage} alt="Bright white custom kitchen with a wood island and seating" /><span class="project-card__label"><span>Kitchen</span>Two-tone custom cabinetry</span></a>
        <a class="project-card" href="/gallery/"><Image src={vanityImage} alt="Floating wood bathroom vanity with fluted drawer fronts" /><span class="project-card__label"><span>Vanity</span>Fluted wood detail</span></a>
        <a class="project-card" href="/gallery/"><Image src={builtInImage} alt="Illuminated dark wood display cabinetry" /><span class="project-card__label"><span>Built-in</span>Display and beverage centre</span></a>
        <a class="project-card" href="/gallery/"><Image src={mudroomImage} alt="Custom wood mudroom bench and tall storage cabinet" /><span class="project-card__label"><span>Storage</span>Made-to-measure mudroom</span></a>
      </div>
      <p style="margin-top: 2rem"><a class="text-link" href="/gallery/">View the full gallery <Icon name="arrow" /></a></p>
    </div>
  </section>

  <section class="section section--dark" aria-labelledby="process-title">
    <div class="container">
      <div class="section-header section-header--light">
        <div><p class="eyebrow">Our process</p><h2 id="process-title">From your ideas to a finished space.</h2></div>
        <p>Clear steps, thoughtful guidance, and attention to detail help make your cabinetry project feel manageable.</p>
      </div>
      <div class="process-grid">
        <div class="process-step"><Icon name="measure" size={34} /><span>01</span><h3>Free consultation</h3><p>Tell us about your project, space, style, and what you would like to achieve.</p></div>
        <div class="process-step"><Icon name="design" size={34} /><span>02</span><h3>Design & selection</h3><p>We plan the layout and help you compare doors, colours, finishes, and hardware.</p></div>
        <div class="process-step"><Icon name="build" size={34} /><span>03</span><h3>Final design</h3><p>We refine the details so you understand what is being created for your home.</p></div>
        <div class="process-step"><Icon name="install" size={34} /><span>04</span><h3>Installation</h3><p>Your finished cabinetry is installed with care as a functional part of your home.</p></div>
      </div>
    </div>
  </section>

  <section class="section section--ivory" aria-labelledby="commitment-title">
    <div class="container testimonial">
      <span class="testimonial__mark" aria-hidden="true">“</span>
      <p class="eyebrow">Our commitment</p>
      <blockquote id="commitment-title">Great cabinetry should feel completely at home in your space.</blockquote>
      <p>We combine personalized guidance, practical storage, and beautiful design to create cabinetry that fits your goals and budget.</p>
    </div>
  </section>
  <CTA />
</BaseLayout>

